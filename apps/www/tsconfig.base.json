{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "node",
      "mdx"
    ],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "incremental": true,
    "paths": {
      "@/*": [
        "./*"
      ],
      "@registry/*": [
        "../../registry/src/*"
      ]
    },
    "allowJs": true,
    "jsx": "preserve",
    "useDefineForClassFields": true
  }
}
