{
  "name": "@echo-ui/www",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Echo UI docs site + registry host. Also the Next.js SSR smoke app.",
  "license": "MIT",
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "safari >= 16.2",
    "firefox >= 113"
  ],
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-reporter=spec \"components/**/*.test.ts\"",
    "build:static": "ECHO_STATIC_EXPORT=1 next build --webpack && node scripts/prune-fixtures.mjs && node scripts/sitemap.mjs",
    "preview": "pnpm build:static && wrangler dev",
    "deploy:site": "node scripts/repo-public.mjs && pnpm --filter @echo-ui/registry build && pnpm build:static && node scripts/released-only.mjs && wrangler deploy"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource-variable/red-hat-display": "^5.3.0",
    "@fontsource-variable/red-hat-mono": "^5.3.0",
    "@fontsource-variable/red-hat-text": "^5.3.0",
    "@fontsource/architects-daughter": "^5.3.0",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "16.4.2",
    "@react-three/fiber": "9.8.2",
    "echo-ui-core": "workspace:*",
    "gsap": "^3.13.0",
    "lenis": "1.3.27",
    "mediabunny": "1.61.5",
    "next": "16.4.2",
    "paperlab": "file:vendor/paperlab-0.8.1-scroll-2.tgz",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remark-gfm": "^4.0.1",
    "sugar-high": "2.5.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.186.0",
    "react-hook-form": "^7.90.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "wrangler": "^4.151.0"
  }
}
