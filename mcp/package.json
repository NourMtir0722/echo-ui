{
  "name": "echo-ui-mcp",
  "version": "0.3.5",
  "mcpName": "com.echo-ui/mcp",
  "type": "module",
  "description": "Echo UI is a tactile React component library, and the design system that keeps your AI agent on-brand. As an MCP server, it lets an agent search Echo UI's components by the job, read one, and get its tokens and accessibility rules before writing code.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "echo-ui",
    "design-system",
    "react",
    "components",
    "ai",
    "agent",
    "tactile",
    "skeuomorphic",
    "react-components",
    "component-library",
    "ui-library",
    "ui-components"
  ],
  "license": "MIT",
  "author": "Nawwara Studio",
  "homepage": "https://echo-ui.com",
  "funding": "https://echo-ui.com/support",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NourMtir0722/echo-ui.git",
    "directory": "mcp"
  },
  "bugs": {
    "url": "https://github.com/NourMtir0722/echo-ui/issues"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "bin": {
    "echo-ui-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build.mjs",
    "prepublishOnly": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "dev:worker": "wrangler dev",
    "deploy:worker": "wrangler deploy",
    "build:plugin": "tsx src/build-plugin.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@echo-ui/client": "workspace:*",
    "@types/node": "^26.6.5",
    "echo-ui-core": "workspace:*",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "wrangler": "^4.151.0"
  }
}
