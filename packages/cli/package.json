{
  "name": "echo-ui-cli",
  "version": "0.3.2",
  "private": true,
  "description": "The design system that keeps your AI on-brand: install Echo UI's tactile components with init and add, and give your agent which, docs and check.",
  "keywords": [
    "echo-ui",
    "react",
    "design-system",
    "cli"
  ],
  "homepage": "https://echo-ui.com",
  "funding": "https://echo-ui.com/support",
  "license": "MIT",
  "author": "Nawwara Studio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NourMtir0722/echo-ui.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/NourMtir0722/echo-ui/issues"
  },
  "type": "module",
  "bin": {
    "echo-ui": "./dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "build": "node build.mjs"
  },
  "dependencies": {
    "axe-core": "4.14.0",
    "echo-ui-core": "workspace:*"
  },
  "devDependencies": {
    "@babel/parser": "^7",
    "@echo-ui/client": "workspace:*",
    "@types/pngjs": "^6",
    "esbuild": "^0.28.2",
    "jpeg-js": "^0.4",
    "pngjs": "^7",
    "postcss": "^8",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "echoUi": {
    "commands": [
      "init",
      "which",
      "docs",
      "check",
      "test",
      "style",
      "agent",
      "add",
      "list",
      "diff",
      "update"
    ]
  }
}
