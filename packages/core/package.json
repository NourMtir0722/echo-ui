{
  "name": "echo-ui-core",
  "version": "0.3.0",
  "private": true,
  "description": "The design system that keeps your AI on-brand: Echo UI's grammar, the theme engine, tokens, material, sound, motion and tactile feedback that every Echo component is made from.",
  "keywords": [
    "echo-ui",
    "react",
    "design-system",
    "design-tokens",
    "theme",
    "sound",
    "motion"
  ],
  "homepage": "https://echo-ui.com",
  "funding": "https://echo-ui.com/support",
  "license": "MIT",
  "browserslist": ["chrome >= 111", "edge >= 111", "safari >= 16.2", "firefox >= 113"],
  "author": "Nawwara Studio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NourMtir0722/echo-ui.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/NourMtir0722/echo-ui/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./theme": "./src/theme/index.ts",
    "./theme/material.css": "./src/theme/material.css",
    "./sound": "./src/sound/index.ts",
    "./motion": "./src/motion/motion.ts",
    "./tactile": "./src/tactile/index.ts",
    "./presence": "./src/presence/index.ts",
    "./check": {
      "development": "./src/check/index.tsx",
      "default": "./src/check/off.ts"
    },
    "./types": "./src/types/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "peerDependencies": {
    "gsap": "^3.12.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "gsap": "^3.13.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  }
}
