# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
# Any Next dist dir: NEXT_DIST_DIR gives the dev server (.next-dev) and
# verification builds their own, so match the family rather than listing them.
.next*/
out/
*.tsbuildinfo

# Registry build artifacts (generated from registry/ sources)
apps/www/public/r/
# /e/ is built from the sources plus registry/e-released (the released pins,
# which ARE in the repo, because a published version has to stay resolvable).
apps/www/public/e/
apps/www/public/llms.txt
apps/www/public/llms-full.txt
apps/www/public/plugin/
registry/dist/
# The plugin's two folders and its ZIP, generated by `build:plugin` (mcp/src/plugin.ts).
mcp/dist-plugin/

# Static export for Cloudflare (apps/www/out)
out/

# wrangler's local miniflare state (sqlite caches, D1, R2, KV emulation)
.wrangler/

# npm pack output
*.tgz
# ...except a dependency the site takes from the repo itself (apps/www/vendor/README.md).
!apps/www/vendor/*.tgz

# Test / tooling
playwright-report/
test-results/
coverage/
.turbo/

# Env / editor / OS
.env
.env.*
!.env.example
.DS_Store
.vscode/
.idea/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*


# Generated by every `next dev` and `next build`, and rewritten to point at
# whichever NEXT_DIST_DIR that run used — so a tracked copy is dirty after any
# Playwright run. The references that matter are hand-authored in
# apps/www/echo-env.d.ts, which no build tool touches.
apps/www/next-env.d.ts
